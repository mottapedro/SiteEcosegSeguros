<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
  <defs>
    <!-- Gradiente Oficial Latão Nobre EcoSeg (ADR-B-001) -->
    <linearGradient id="brass-grad-fav" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E8D5BC" />
      <stop offset="35%" stop-color="#D4B892" />
      <stop offset="70%" stop-color="#C5A880" />
      <stop offset="100%" stop-color="#9B7C50" />
    </linearGradient>
    <radialGradient id="bg-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#141E2E" />
      <stop offset="100%" stop-color="#080D14" />
    </radialGradient>
  </defs>

  <!-- Fundo Obsidian com borda arredondada sutil -->
  <rect width="100" height="100" rx="22" fill="url(#bg-glow)" />
  <rect width="98" height="98" x="1" y="1" rx="21" fill="none" stroke="#C5A880" stroke-width="1" stroke-opacity="0.3" />

  <!-- 1. Viga Estrutural de Fundação (Apoio e Firmeza) -->
  <rect x="20" y="74" width="60" height="5.5" rx="2" fill="url(#brass-grad-fav)" />

  <!-- 2. Coluna Âncora de Compreensão (Monólito Esquerdo) -->
  <rect x="20" y="22" width="5.5" height="52" rx="1.5" fill="url(#brass-grad-fav)" />
  <!-- Capitel da Coluna -->
  <rect x="17.5" y="21" width="10.5" height="3" rx="1" fill="url(#brass-grad-fav)" />

  <!-- 3. Arco do Horizonte e Dinamismo ('S' / 'E') -->
  <path
    d="M 22 28 C 38 17, 65 17, 76 27 C 82 31, 82 39, 75 43 C 67 47, 46 47, 36 52 C 26 57, 26 67, 36 71 C 46 75, 66 75, 78 71"
    stroke="url(#brass-grad-fav)"
    stroke-width="5.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  />

  <!-- 4. Pivot Diamante Central (Inteligência & Decisão Consultiva) -->
  <polygon points="50,43 56,49 50,55 44,49" fill="#E8D5BC" />

  <!-- 5. Acento Meridiano Superior -->
  <circle cx="72" cy="29" r="2.2" fill="#C5A880" />
</svg>
